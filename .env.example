# 실제 키는 .env.local에만 입력하세요. 브라우저에 전송되지 않습니다.
# Render에서는 Environment에 GEMINI_API_KEY를 설정합니다. 키만 넣어도 기본 모델로 연결됩니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# false로 설정하면 Gemini 연결을 끌 수 있습니다.
AI_PUBLIC_ENABLED=true
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=30000
AI_DAILY_REQUEST_LIMIT=50
# 수집은 관리 화면에서 확인한 공개 피드만 등록하고 실행합니다.
TRENDS_AUTO=false

# 트렌드 수집: Bluesky 공개 API, YouTube·Instagram 공개 HTML 방식으로 API 키가 필요 없습니다.
# Instagram은 로그인 제한 또는 공개 캡션·게시 시각 미제공 시 수집할 수 없습니다.
